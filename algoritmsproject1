using System;
using System.Collections.Generic;
using System.Linq;

enum LocomotiveStatus
{
    Idle,       // Not staged
    Staged,     // On departure track waiting
    Departed,   // Dispatched (active/in-transit)
    Siding,     // On siding
    Arrived     // Reached destination
}

class Locomotive
{
    public string ID { get; }
    public string Name { get; }
    public string Destination { get; set; } = null!;
    public LocomotiveStatus Status { get; set; } = LocomotiveStatus.Idle;

    public Locomotive(string id, string name)
    {
        ID = id;
        Name = name;
    }

    public override string ToString() => ID;
}

class YardLedger
{
    // All locomotives by ID for quick lookup
    private readonly Dictionary<string, Locomotive> all = new();

    // Departure track: front is 0 (use LinkedList to allow O(1) removals/inserts at front)
    private readonly LinkedList<Locomotive> departureTrack = new();

    // Siding: LIFO stack
    private readonly Stack<Locomotive> siding = new();

    // Active (dispatched) locomotives
    private readonly List<Locomotive> active = new();

    public void AddLocomotive(Locomotive loco)
    {
        if (!all.ContainsKey(loco.ID))
            all[loco.ID] = loco;
    }

    // Stage locomotive: set destination, set status, and put at end of departure track (back)
    public void StageLocomotive(Locomotive loco, string destination)
    {
        if (!all.ContainsKey(loco.ID))
            AddLocomotive(loco);

        loco.Destination = destination;
        loco.Status = LocomotiveStatus.Staged;
        departureTrack.AddLast(loco);
        Console.WriteLine($"{loco.ID} successfully staged for {destination}");
    }

    // Dispatch next: remove front of departure track, mark Departed and add to active
    public void DispatchNextDeparture()
    {
        if (departureTrack.Count == 0)
        {
            Console.WriteLine("No locomotives ready to depart");
            return;
        }

        var loco = departureTrack.First!.Value;
        departureTrack.RemoveFirst();
        loco.Status = LocomotiveStatus.Departed;
        active.Add(loco);
        Console.WriteLine($"{loco.ID} now has a status of {loco.Status} and is heading to {loco.Destination}");
    }

    // Mark arrived by name (ID string)
    public void MarkArrivedByName(string id)
    {
        if (!all.ContainsKey(id))
        {
            Console.WriteLine($"No such locomotive {id}");
            return;
        }

        var loco = all[id];
        loco.Status = LocomotiveStatus.Arrived;
        // remove from active if present
        active.RemoveAll(l => l.ID == id);
        Console.WriteLine($"{loco.ID} has arrived in {loco.Destination}");
    }

    // List staged locomotives (IDs front->back)
    public void ListStagedLocomotives()
    {
        var list = departureTrack.Select(l => l.ID).ToList();
        if (list.Count == 0) { Console.WriteLine("(no staged locomotives)"); return; }
        Console.WriteLine(string.Join(", ", list));
    }

    // List active locomotives (IDs)
    public void ListActiveLocomotives()
    {
        var list = active.Select(l => l.ID).ToList();
        if (list.Count == 0) { Console.WriteLine("(no active locomotives)"); return; }
        Console.WriteLine(string.Join(", ", list));
    }

    // Move next k from front of departure track to siding (up to k)
    public void MoveNextKToSiding(int k)
    {
        for (int i = 0; i < k && departureTrack.Count > 0; i++)
        {
            var loco = departureTrack.First!.Value;
            departureTrack.RemoveFirst();
            loco.Status = LocomotiveStatus.Siding;
            siding.Push(loco);
            Console.WriteLine($"{loco.ID} has been moved to siding");
        }
    }

    // Return all siding to departure track. Implementation specified so that LIFO siding
    // elements are popped and inserted at the front of the departure track (so top of siding becomes first)
    public void ReturnAllSidingToDepartureTrack()
    {
        while (siding.Count > 0)
        {
            var loco = siding.Pop();
            loco.Status = LocomotiveStatus.Staged;
            // Insert at front (so popped order places them before existing departure track items)
            departureTrack.AddFirst(loco);
            Console.WriteLine($"{loco.ID} has been moved to the departure track");
        }
    }

    // Aggregate by destination (include staged and active, exclude arrived)
    public void AggregateByDestination()
    {
        // Consider all locomotives that are not Arrived
        var relevant = all.Values.Where(l => l.Status != LocomotiveStatus.Arrived);

        var map = new SortedDictionary<string, List<string>>(StringComparer.OrdinalIgnoreCase);
        foreach (var loco in relevant)
        {
            var dest = loco.Destination ?? "(unknown)";
            if (!map.ContainsKey(dest)) map[dest] = new List<string>();
            map[dest].Add(loco.ID);
        }

        foreach (var kv in map)
        {
            Console.WriteLine($"{kv.Key}: {string.Join(", ", kv.Value)}");
        }
    }

    // Inspect next departure (return ID or print nothing if none)
    public void InspectNextDeparture()
    {
        if (departureTrack.Count == 0)
            Console.WriteLine("(none)");
        else
            Console.WriteLine(departureTrack.First!.Value.ID);
    }
}

class Program
{
    static void Main()
    {
        var ledger = new YardLedger();

        // Scenario 0: Create 5 locomotives (no output)
        var L1 = new Locomotive("L1", "Commodore");
        var L2 = new Locomotive("L2", "Alva");
        var L3 = new Locomotive("L3", "Consuelo");
        var L4 = new Locomotive("L4", "Idler");
        var L5 = new Locomotive("L5", "North Star");

        ledger.AddLocomotive(L1);
        ledger.AddLocomotive(L2);
        ledger.AddLocomotive(L3);
        ledger.AddLocomotive(L4);
        ledger.AddLocomotive(L5);

        // 1
        ledger.StageLocomotive(L1, "Albany");
        // 2
        ledger.StageLocomotive(L2, "Pittsburgh");
        // 3
        ledger.StageLocomotive(L3, "Chicago");
        // 4
        ledger.StageLocomotive(L4, "Chicago");
        // 5
        ledger.StageLocomotive(L5, "Pittsburgh");

        // 6
        ledger.DispatchNextDeparture();

        // 7
        ledger.MoveNextKToSiding(2);

        // 8
        ledger.DispatchNextDeparture();

        // 9
        ledger.ListActiveLocomotives();

        // 10
        ledger.ReturnAllSidingToDepartureTrack();

        // 11
        ledger.ListStagedLocomotives();

        // 12
        ledger.InspectNextDeparture();

        // 13
        ledger.AggregateByDestination();

        // 14
        ledger.MarkArrivedByName("L1");

        // 15
        ledger.ListActiveLocomotives();
    }
}
